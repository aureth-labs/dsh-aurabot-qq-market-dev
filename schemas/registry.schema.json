{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurabot.dev/schemas/registry.schema.json",
  "title": "市场收录表 registry.json",
  "type": "object",
  "required": ["schema", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package"],
        "additionalProperties": false,
        "properties": {
          "package": {
            "type": "string",
            "description": "作者仓库里 package.json 的直链（raw.githubusercontent.com 或 jsDelivr）"
          },
          "note": { "type": "string", "description": "维护者备注，不参与构建" }
        }
      }
    }
  }
}

